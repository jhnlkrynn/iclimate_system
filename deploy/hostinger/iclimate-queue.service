[Unit]
Description=iClimate Laravel queue worker
After=network-online.target mariadb.service iclimate-python.service
Wants=network-online.target mariadb.service iclimate-python.service
# The worker exits while MariaDB is unreachable. It is restarted every 15 s without a start limit, so it returns by
# itself after a database outage of any length (verification 2026-11-18: with a 10-in-5-minutes limit, an outage over
# ~50 s left the queue stopped until a manual reset-failed). 15 s between attempts is not a tight loop; a worker that
# keeps failing still shows in iclimate:health (oldest job waiting) and in journalctl -u iclimate-queue.
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/iclimate_system
EnvironmentFile=/etc/iclimate/iclimate.env
ExecStart=/usr/bin/php artisan queue:work database --queue=analytics,default,broadcasts --sleep=3 --tries=2 --timeout=300 --max-time=3600
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=330
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/www/iclimate_system/storage /var/www/iclimate_system/bootstrap/cache

[Install]
WantedBy=multi-user.target

