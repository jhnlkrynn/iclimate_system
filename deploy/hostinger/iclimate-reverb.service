[Unit]
Description=iClimate Laravel Reverb WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/iclimate_system
EnvironmentFile=/etc/iclimate/iclimate.env
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/www/iclimate_system/storage /var/www/iclimate_system/bootstrap/cache

[Install]
WantedBy=multi-user.target

