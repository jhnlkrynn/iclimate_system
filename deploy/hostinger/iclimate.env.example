# Copy to /etc/iclimate/iclimate.env; chown root:www-data and chmod 640 (directory 750).
# PHP-FPM and systemd services must be able to read it. Do not commit the real file.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://iclimate-lian.tech
APP_KEY=REPLACE_WITH_GENERATED_LARAVEL_KEY
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_PRODUCTION_DATABASE
DB_USERNAME=REPLACE_WITH_RUNTIME_ACCOUNT
DB_PASSWORD=REPLACE_WITH_SECRET
# TIMESTAMP session zone. Must be +08:00 on every server that serves the migrated data, or all
# timestamps read back shifted (a UTC server shows them 8 hours early). See config/database.php.
DB_TIMEZONE=+08:00

BACKUP_DB_CONNECTION=mysql_backup
BACKUP_DIRECTORY=/var/backups/iclimate
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=3306
# Same value as DB_DATABASE, written out: systemd EnvironmentFile= (used by the queue, scheduler, Reverb and ML units)
# may not expand ${...} references, and real environment variables take precedence over .env in Laravel.
BACKUP_DB_DATABASE=REPLACE_WITH_PRODUCTION_DATABASE
BACKUP_DB_USERNAME=REPLACE_WITH_BACKUP_ACCOUNT
BACKUP_DB_PASSWORD=REPLACE_WITH_SECRET
MYSQLDUMP_BINARY=/usr/bin/mariadb-dump

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database

FARMING_AI_API_URL=http://127.0.0.1:8010
FARMING_AI_CONNECT_TIMEOUT=3
FARMING_AI_ANALYTICS_TIMEOUT=60
FARMING_AI_QUEUE_CONNECTION=database
FARMING_AI_QUEUE=analytics

REVERB_APP_ID=REPLACE_WITH_SECRET_STORE_VALUE
REVERB_APP_KEY=REPLACE_WITH_SECRET_STORE_VALUE
REVERB_APP_SECRET=REPLACE_WITH_SECRET_STORE_VALUE
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Laravel publishes directly to the private Reverb listener; browsers use HTTPS below.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://iclimate-lian.tech,https://www.iclimate-lian.tech
# Public app key must equal REVERB_APP_KEY; it is embedded into the frontend build.
VITE_REVERB_APP_KEY=REPLACE_WITH_PUBLIC_REVERB_APP_KEY
VITE_REVERB_HOST=iclimate-lian.tech
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https


# Audit 2026-11-18 (Phase 19)
# Shared-password lockdown. Production: true. (Even when false, a shared password never works from the network.)
# Turn on with the recovery rollout: docs/deployment/ICLIMATE_RELEASE_HANDOFF.md, step 6.
ICLIMATE_PASSWORD_LOCKDOWN=true
# Rice-yield estimates outside the model's training range: withhold | label | off. ACCURACY NOT VERIFIED.
# label (owner decision 2026-11-20): the number is shown marked "Unvalidated estimate, not a recommendation".
ICLIMATE_YIELD_GATE=label
# Under withhold, even in-range estimates stay hidden until the owner approves an independent validation. Keep false.
ICLIMATE_YIELD_ACCURACY_VERIFIED=false
