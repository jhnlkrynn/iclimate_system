  users { bigint id PK; string name; string email UK; string role; string status; string barangay; string contact_number; text address; timestamp email_verified_at; string password; timestamp last_login_at; timestamp approved_at; bigint approved_by FK_nullable; string rejection_reason; string avatar_path; timestamps }
