APP_NAME="iClimate"
APP_VERSION=
APP_DEPLOYED_AT=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ICLIMATE_DEFAULT_ACCOUNT_PASSWORD=
# Password StaffLoginAccountSeeder gives it@gmail.com and mao@gmail.com. Leave empty to skip those accounts.
ICLIMATE_STAFF_ACCOUNT_PASSWORD=
# First password of farmer accounts imported by FarmerMasterlistSeeder. Empty: each gets its own random password.
ICLIMATE_FARMER_ACCOUNT_PASSWORD=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iclimate_db
DB_USERNAME=root
DB_PASSWORD=
# Seconds to wait for the database connection to open before showing the "Data Service Unavailable" page
# (MySQL and PostgreSQL). PostgreSQL waits this long for each address of DB_HOST, one after the other.
# DB_CONNECT_TIMEOUT=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true whenever APP_URL uses https:// (i.e. any real deployment).
# Only false is safe for local http://127.0.0.1 development.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WEATHER_API_ENABLED=true
WEATHER_API_TIMEOUT=8
# Location (Lian, Batangas: coordinates, name, Asia/Manila) is defined once in app/Support/LianLocation.php.
# It used to be repeated here under four different names; none of them needs to be set.
WEATHER_API_FORECAST_DAYS=5
WEATHER_API_REFRESH_MINUTES=45

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_PROVIDER=open_meteo
WEATHERAPI_KEY=

WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_TIMEOUT=8
WEATHER_CACHE_MINUTES=5
WEATHER_POLL_SECONDS=300
WEATHER_FORECAST_DAYS=7
OPEN_METEO_TIMEOUT=10
OPEN_METEO_FORECAST_DAYS=16

PAGASA_ADVISORIES_ENABLED=true
PAGASA_REGIONAL_FORECAST_URL=https://bagong.pagasa.dost.gov.ph/regional-forecast/ncrprsd
PAGASA_WEEKLY_OUTLOOK_URL=https://pagasa.dost.gov.ph/weather/weather-outlook-weekly
PAGASA_TIMEOUT=12
PAGASA_CACHE_MINUTES=30
PAGASA_LOCATION_KEYWORDS="Lian,Batangas"

# iClimate ML service (python_scripts/main.py, FastAPI). Run locally with:
#   .venv-ml/Scripts/python.exe -m uvicorn main:app --host 127.0.0.1 --port 8010
# (cwd: python_scripts/).
FARMING_AI_API_URL=http://127.0.0.1:8010
# Optional. Leave empty to auto-detect .venv/bin/python on macOS/Linux or
# .venv/Scripts/python.exe on Windows.
PYTHON_BINARY=
FARMING_AI_API_TIMEOUT=5
FARMING_AI_CONNECT_TIMEOUT=3
FARMING_AI_ANALYTICS_TIMEOUT=60
FARMING_AI_CACHE_MINUTES=30
FARMING_AI_QUEUE_CONNECTION=database
FARMING_AI_QUEUE=analytics
# Seconds a requested prediction/report may wait for the queue worker, or run, before the page offers "try again".
FARMING_AI_PENDING_TIMEOUT=90
FARMING_AI_PROCESSING_TIMEOUT=300

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=12

# Model registry: activation switches the live Python model. ML_ADMIN_TOKEN must be identical here
# and in the Python service environment. Generate with: openssl rand -hex 32
ML_ADMIN_TOKEN=
RICE_YIELD_SYNC_RUNTIME=true

# pg_restore is used only to LIST a backup archive (iclimate:verify-backup); nothing is restored.
PG_RESTORE_BINARY=

# iclimate:test-restore (manual): restores the latest backup into a temporary, network-less local Docker container.
# The image major version must be >= the pg_dump version that made the backups.
# RESTORE_TEST_IMAGE=postgres:17
# DOCKER_BINARY=docker

# Climora AI response time (all optional; defaults shown)
# AI_RESPONSE_BUDGET=10          whole-request budget in seconds; Groq is skipped once too little is left
# AI_GROQ_TIMEOUT=4              Groq limit per call (seconds), no retries
# AI_GROQ_COOLDOWN=30            seconds to skip Groq after a timeout / 429 / 5xx
# AI_GROQ_PHRASING=false         true = Groq re-words answers iClimate already has (slower)
# AI_WEATHER_TIMEOUT=3           per-provider limit when the weather cache is cold
# AI_WEATHER_MAX_AGE=10          minutes of old weather the chatbot will reuse
# AI_FOREST_CACHE_HOURS=24       how long the monthly weather forest result is cached
# AI_PREDICTION_RESULT_CACHE=600   seconds the same person + same prediction question reuses its answer
# ICLIMATE_WEATHER_CACHE_MINUTES=1560   how long prepared monthly forecasts count as fresh (refreshed daily at 02:00/02:15)

# Page speed (all optional; defaults shown)
# DB_PGSQL_DISABLE_PREPARES=true one network round trip per PostgreSQL query instead of three (~180 ms vs ~500 ms to Supabase)
# DB_PERSISTENT=false            true reuses the Supabase connection between requests (~0.5 s faster per request; opt-in)
# DB_STARTUP_SEARCH_PATH=true    send the schema when connecting instead of a SET statement (one round trip less)
# AUTH_USER_CACHE_SECONDS=30     how long the signed-in user is remembered between requests (dropped at once when they change)
# After deploying: run "npm run build" (compiled assets) and "php artisan optimize" (config, routes, views, events).


# Database backups: mysqldump for MySQL/MariaDB (XAMPP's copy is found automatically), pg_dump for PostgreSQL.
MYSQLDUMP_BINARY=
# MAIL_MAILER=log writes emails to the log only: the forgot-password page then tells people to ask MAO/IT
# for a new password. Set real SMTP details to turn password reset by email on.
# Web server started by start-services.bat: "apache" (Apache + 4 PHP workers, for real use; see deploy/) or "artisan" (dev server, one request at a time).
ICLIMATE_WEB_SERVER=artisan
# ICLIMATE_WEB_PORT=8000
# ICLIMATE_APACHE_DIR=C:/xampp/apache
# 127.0.0.1 = this computer only (default). 0.0.0.0 = other computers on the same network can open the site too.
# ICLIMATE_WEB_BIND=127.0.0.1

# Chatbot Knowledge pages in the interface (IT sidebar tab). false = hidden; the chatbot still uses the knowledge.
CHATBOT_KNOWLEDGE_UI=false
