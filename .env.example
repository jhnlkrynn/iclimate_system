APP_NAME="iClimate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ICLIMATE_DEFAULT_ACCOUNT_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iclimate_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WEATHER_API_ENABLED=true
OPENWEATHER_API_KEY=
WEATHER_API_TIMEOUT=8
WEATHER_API_LOCATION_NAME="Lian, Batangas"
WEATHER_API_LATITUDE=14.04
WEATHER_API_LONGITUDE=120.65
WEATHER_API_TIMEZONE=Asia/Manila
WEATHER_API_FORECAST_DAYS=5

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ICLIMATE_LATITUDE=14.033
ICLIMATE_LONGITUDE=120.650
ICLIMATE_TIMEZONE=Asia/Manila
ICLIMATE_LOCATION_NAME="Lian, Batangas"
OPEN_METEO_TIMEOUT=10
OPEN_METEO_FORECAST_DAYS=16

PAGASA_ADVISORIES_ENABLED=true
PAGASA_REGIONAL_FORECAST_URL=https://bagong.pagasa.dost.gov.ph/regional-forecast/ncrprsd
PAGASA_WEEKLY_OUTLOOK_URL=https://pagasa.dost.gov.ph/weather/weather-outlook-weekly
PAGASA_TIMEOUT=12
PAGASA_CACHE_MINUTES=30
PAGASA_LOCATION_KEYWORDS="Lian,Batangas"

FARMING_AI_API_URL=http://127.0.0.1:5001
FARMING_AI_API_TIMEOUT=5

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=12
